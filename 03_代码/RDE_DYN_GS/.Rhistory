# 生成模拟数据
set.seed(123)
n <- 1000  # 样本量
p <- 50    # SNP数量
snp_data <- matrix(rbinom(n * p, 2, 0.3), nrow = n)  # 模拟基因型（0/1/2）
time_values <- runif(n, 0, 10)  # 时间变量
y <- sin(time_values) * rowMeans(snp_data) + rnorm(n, sd = 0.5)  # 动态遗传效应（非线性）
y
snp_data
time_values
y
# 1. 模拟数据
set.seed(123)
n <- 1000; m <- 50
marker_effects <- matrix(rnorm(n * m, sd = 0.5), nrow = n)
time_values <- runif(n, 0, 10)
y <- rowSums(marker_effects) * sin(time_values) + rnorm(n, sd = 0.2)
# 2. RFF特征映射
random_fourier_features <- function(X, gamma = 1.0, D = 100) {
omega <- matrix(rnorm(D * ncol(X), sd = sqrt(2 * gamma)), ncol = ncol(X))
b <- runif(D, 0, 2 * pi)
Z <- cos(sweep(X %*% t(omega), 2, b, "+")) * sqrt(2 / D)
return(Z)
}
marker_effects
time_values <- runif(n, 0, 10)
y <- rowSums(marker_effects) * sin(time_values) + rnorm(n, sd = 0.2)
# 2. RFF特征映射
random_fourier_features <- function(X, gamma = 1.0, D = 100) {
omega <- matrix(rnorm(D * ncol(X), sd = sqrt(2 * gamma)), ncol = ncol(X))
b <- runif(D, 0, 2 * pi)
Z <- cos(sweep(X %*% t(omega), 2, b, "+")) * sqrt(2 / D)
return(Z)
}
X <- cbind(scale(marker_effects), scale(time_values))
Z <- random_fourier_features(X, gamma = 0.1, D = 100)
Z
# 3. 建模（弹性网络）
library(glmnet)
dim(z)
Z
install.packages("glmnet")
cv_fit <- cv.glmnet(Z, y, alpha = 0.5)
# 3. 建模（弹性网络）
library(glmnet)
cv_fit <- cv.glmnet(Z, y, alpha = 0.5)
final_model <- glmnet(Z, y, alpha = 0.5, lambda = cv_fit$lambda.min)
final_model
# 4. 可视化
library(ggplot2)
df_plot <- data.frame(
Time = time_values,
True_Effect = rowSums(marker_effects) * sin(time_values),
Predicted_Effect = predict(final_model, newx = Z)
ggplot(df_plot, aes(x = Time)) +
